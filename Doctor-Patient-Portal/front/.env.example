# ============================================================
# Environment Variables
# ============================================================

# API base URL for the Spring Boot backend (proxied via Vite in dev).
# In development this maps through the Vite dev-server proxy (vite.config.ts).
# In production, set this to the deployed backend URL (e.g. https://api.example.com).
VITE_API_BASE_URL=/api

# ============================================================
# Backend Configuration (reference)
# ============================================================
# The Spring Boot backend runs on port 8080 by default:
#   back/src/main/resources/application.properties  →  server.port=8080
# The Vite dev server runs on port 5173 and proxies /api → http://localhost:8080.
